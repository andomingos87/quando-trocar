{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-sync-agent-assets.mjs"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/sync-agent-assets.mjs"
      }
    ],
    "preToolUse": [
      {
        "command": "[ ! -f \".cursor/skills/impeccable/scripts/hook-before-edit.mjs\" ] || node \".cursor/skills/impeccable/scripts/hook-before-edit.mjs\"",
        "timeout": 5
      }
    ]
  }
}
